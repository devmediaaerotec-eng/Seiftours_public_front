# Copy this file to .env and fill in your values.

# Supabase — get from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# MyGo API credentials — provided by MyGo agency portal.
# Server-only (used by api/mygo.ts): no VITE_ prefix, so they never reach the browser.
# On Vercel, set them in Project Settings -> Environment Variables.
MYGO_LOGIN=your-mygo-login
MYGO_PASSWORD=your-mygo-password
