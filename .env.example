# Copy to .env.local (git-ignored) for `npm run dev`; on Vercel/Cloudflare set them in Project Settings > Environment Variables.
# Server-only (read by api/mygo.ts, never sent to the browser: no VITE_ prefix)
MYGO_LOGIN=
MYGO_PASSWORD=

# Browser-exposed (VITE_ prefix). Leave empty in dev to use the Vite proxy / same origin.
# In production set both to the Symfony API origin, e.g. https://api.example.tn
VITE_API_URL=
# Base URL for uploaded images/assets (served by the backend), e.g. https://api.example.tn
VITE_ASSET_BASE=
